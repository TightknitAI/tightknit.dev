---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import RepoGrid from '../components/RepoGrid.astro';
import UpstreamSupport from '../components/UpstreamSupport.astro';
import Manifesto from '../components/Manifesto.astro';
import Footer from '../components/Footer.astro';
import { loadRepos } from '../lib/github';

const { repos, usedFallback } = await loadRepos('tightknitai');

if (usedFallback) {
  console.warn('[index] using fallback repos. Set GITHUB_TOKEN to fetch live data');
}

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'tightknit open source repositories',
  description:
    'TypeScript libraries, agents, and developer tools for Slack apps and AI agents, maintained by tightknit.',
  numberOfItems: repos.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: repos.map((repo, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'SoftwareSourceCode',
      name: repo.name,
      identifier: repo.fullName,
      description: repo.description ?? undefined,
      codeRepository: repo.url,
      url: repo.url,
      programmingLanguage: repo.language ?? undefined,
      keywords: repo.topics.length > 0 ? repo.topics.join(', ') : undefined,
      dateModified: repo.pushedAt,
      author: {
        '@type': 'Organization',
        name: 'tightknit',
        url: 'https://tightknit.ai',
      },
    },
  })),
};
---

<Layout jsonLd={[itemListLd]}>
  <Nav />
  <main>
    <Hero />
    <RepoGrid repos={repos} />
    <UpstreamSupport />
    <Manifesto />
  </main>
  <Footer />
</Layout>
