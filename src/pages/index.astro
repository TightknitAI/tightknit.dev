---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import RepoGrid from '../components/RepoGrid.astro';
import Manifesto from '../components/Manifesto.astro';
import Footer from '../components/Footer.astro';
import { loadRepos } from '../lib/github';

const { repos, usedFallback } = await loadRepos('tightknitai');

if (usedFallback) {
  console.warn('[index] using fallback repos — set GITHUB_TOKEN to fetch live data');
}
---

<Layout>
  <Nav />
  <main>
    <Hero repoCount={repos.length} />
    <RepoGrid repos={repos} />
    <Manifesto />
  </main>
  <Footer />
</Layout>
