---
const items = [
  {
    n: '01',
    title: 'Made to be forked.',
    body: "Every repo is MIT (or compatible). Lift it, mod it, ship it. The point is that you don't have to ask.",
  },
  {
    n: '02',
    title: 'TypeScript first.',
    body: 'Strict mode on, types as docs, end-to-end inference where possible. Runtimes: Node, Bun, Cloudflare Workers.',
  },
  {
    n: '03',
    title: 'Built in public.',
    body: 'Roadmaps in GitHub issues, releases on a real changelog, and the maintainers actually read PRs.',
  },
];
---

<section class="bg-ink text-cream border-ink relative overflow-hidden border-b-[3px]">
  <div
    class="dotted-bg pointer-events-none absolute inset-0 opacity-30"
    style="background-image: radial-gradient(rgba(243,237,224,0.18) 1.5px, transparent 1.5px); background-size: 22px 22px;"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
    <div class="mb-12 flex items-center gap-4">
      <span class="text-yellow font-mono text-[12px] tracking-[0.18em] uppercase"
        >// principles</span
      >
      <div class="bg-yellow/40 h-[2px] flex-1"></div>
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-12">
      {
        items.map((item) => (
          <div class="border-cream/90 border-t-[3px] pt-6">
            <div class="text-yellow mb-4 font-mono text-[12px] tracking-[0.18em] uppercase">
              {item.n}
            </div>
            <h3 class="font-display mb-4 text-3xl leading-[0.95] font-bold tracking-[-0.03em] lg:text-4xl">
              {item.title}
            </h3>
            <p class="text-cream/80 text-[15px] leading-relaxed lg:text-base">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
