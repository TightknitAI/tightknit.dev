---
// Hide the event pill once the date passes (build-time check).
// To re-use this pattern: add a new entry, point Hero at it.
const SLACK_DEV_DAY_HIDE_AFTER = new Date('2026-05-21T00:00:00Z');
const showSlackDevDay = new Date() < SLACK_DEV_DAY_HIDE_AFTER;

// Must be a PUBLIC GitHub repo — degit downloads anonymous tarballs and 404s on private repos.
const QUICK_START_CMD = 'npx degit tightknitai/slack-hono-template my-slack-app';
---

<section class="border-ink relative overflow-hidden border-b-[3px]">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-90"></div>

  <!-- floating 3d blocks -->
  <div class="pointer-events-none absolute top-12 right-[8%] hidden md:block" aria-hidden="true">
    <div class="float-block float-block-a">
      <div
        class="bg-pink border-ink h-24 w-24 border-[3px]"
        style="box-shadow: 8px 8px 0 var(--color-ink);"
      >
      </div>
    </div>
  </div>
  <div
    class="pointer-events-none absolute right-[22%] bottom-16 hidden lg:block"
    aria-hidden="true"
  >
    <div class="float-block float-block-b">
      <div
        class="bg-cyan border-ink h-16 w-16 border-[3px]"
        style="box-shadow: 6px 6px 0 var(--color-ink);"
      >
      </div>
    </div>
  </div>
  <div class="pointer-events-none absolute top-32 left-[6%] hidden lg:block" aria-hidden="true">
    <div class="float-block float-block-c">
      <div
        class="bg-yellow border-ink h-20 w-20 border-[3px]"
        style="box-shadow: 6px 6px 0 var(--color-ink);"
      >
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 pt-10 pb-12 lg:px-10 lg:pt-14 lg:pb-16">
    {
      showSlackDevDay && (
        <div class="mb-5">
          <a
            href="https://slack.dev/slack-dev-day/"
            target="_blank"
            rel="noopener"
            class="event-pill"
          >
            <svg
              viewBox="0 0 16 14"
              class="text-pink h-4 w-4 shrink-0 animate-pulse"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M0 5 H2 L9 1 V13 L2 9 H0 Z" />
              <path d="M11 4 H12 V10 H11 Z" />
              <path d="M14 5 H15 V9 H14 Z" />
            </svg>
            <span>
              See you at Slack Dev Day · May&nbsp;20&nbsp;<span aria-hidden="true">↗</span>
            </span>
          </a>
        </div>
      )
    }

    <div class="mb-5 inline-flex items-center gap-3">
      <span class="bg-pink inline-block h-2.5 w-2.5 animate-pulse"></span>
      <span class="text-ink/70 font-mono text-[12px] tracking-[0.18em] uppercase">
        for teams building on slack · open source
      </span>
    </div>

    <h1
      class="font-display mb-2 text-[clamp(2.75rem,9vw,7.5rem)] leading-[0.92] font-bold tracking-[-0.04em]"
    >
      <span class="block">TOOLS FOR</span>
      <span class="stacked-3d block">SLACK</span>
      <span class="block">+ AGENTS.</span>
    </h1>

    <p class="text-ink/85 mt-6 max-w-2xl text-lg leading-snug font-medium lg:text-xl">
      Open source libraries, agents, and developer tools shipped by
      <a
        href="https://tightknit.ai"
        target="_blank"
        rel="noopener"
        class="decoration-pink hover:text-pink underline decoration-[3px] underline-offset-4 transition-colors"
        >tightknit.ai</a
      >. Built in TypeScript. Made to be forked.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a href="#repos" class="brutal-btn">
        <span>browse repos</span>
        <span aria-hidden="true">↓</span>
      </a>
      <a
        href="https://github.com/tightknitai"
        target="_blank"
        rel="noopener"
        class="brutal-btn brutal-btn-alt"
      >
        <span>github org</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="mt-6 max-w-2xl">
      <div class="text-ink/60 mb-2 font-mono text-[11px] tracking-[0.18em] uppercase">
        // ship a slack app in 60 seconds
      </div>
      <div
        class="brutal-snippet group"
        role="group"
        aria-label={`Quick-start command: ${QUICK_START_CMD}`}
      >
        <span class="snippet-prompt" aria-hidden="true">$</span>
        <code class="snippet-cmd">{QUICK_START_CMD}</code>
        <button
          type="button"
          class="snippet-copy"
          data-copy={QUICK_START_CMD}
          aria-label="copy command"
        >
          <span class="snippet-copy-default" aria-hidden="true">copy</span>
          <span class="snippet-copy-ok" aria-hidden="true">copied ✓</span>
        </button>
      </div>
    </div>
  </div>

  <!-- marquee strip -->
  <div class="bg-ink text-cream border-ink overflow-hidden border-t-[3px]">
    <div class="marquee py-3 font-mono text-sm tracking-[0.2em] uppercase">
      {
        Array.from({ length: 2 }).map(() => (
          <div class="flex shrink-0 items-center gap-12 px-6">
            <span>open source</span>
            <span class="text-yellow">★</span>
            <span>built in public</span>
            <span class="text-pink">●</span>
            <span>typescript-first</span>
            <span class="text-cyan">◆</span>
            <span>made by tightknit</span>
            <span class="text-yellow">★</span>
            <span>fork it. ship it.</span>
            <span class="text-pink">●</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Copy-to-clipboard for the quick-start snippet (and any future data-copy buttons).
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Clipboard API unavailable (insecure context, permissions). Fall back to a hidden textarea.
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch {
          /* ignore */
        }
        ta.remove();
      }
      btn.classList.add('is-copied');
      window.setTimeout(() => btn.classList.remove('is-copied'), 1500);
    });
  });
</script>
