---
import type { Repo } from '../lib/github';
import { formatRelativeTime } from '../lib/github';

interface Props {
  repo: Repo;
  variant?: 'default' | 'yellow' | 'pink' | 'cyan';
  featured?: boolean;
}

const { repo, variant = 'default', featured = false } = Astro.props;

const variantClass = {
  default: 'brutal-card',
  yellow: 'brutal-card brutal-card-yellow',
  pink: 'brutal-card brutal-card-pink',
  cyan: 'brutal-card brutal-card-cyan',
}[variant];

const headingClass = featured
  ? 'text-3xl sm:text-4xl lg:text-5xl'
  : 'text-2xl sm:text-3xl';

const isInverse = variant === 'pink';
const subTextColor = isInverse ? 'text-cream/85' : 'text-ink/80';
const dividerColor = isInverse ? 'border-cream/25' : 'border-ink/15';
---
<a
  href={repo.url}
  target="_blank"
  rel="noopener"
  class={`${variantClass} block p-6 lg:p-7 group focus:outline-none focus-visible:translate-x-[-3px] focus-visible:translate-y-[-3px]`}
>
  <div class="flex items-start justify-between gap-4 mb-5">
    <div class="font-mono text-[11px] uppercase tracking-[0.16em] opacity-80">
      tightknitai / <span class="opacity-100 font-semibold">{repo.name}</span>
    </div>
    <span class="font-mono text-[18px] leading-none transition-transform group-hover:rotate-[12deg] group-hover:scale-110" aria-hidden="true">↗</span>
  </div>

  <h3 class={`font-display font-bold leading-[0.95] tracking-[-0.03em] ${headingClass} mb-4 break-words`}>
    {repo.name}
  </h3>

  {repo.description && (
    <p class={`text-[15px] lg:text-base leading-snug mb-6 ${subTextColor}`}>
      {repo.description}
    </p>
  )}

  {repo.topics.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-6">
      {repo.topics.slice(0, 5).map((topic) => (
        <span class="tag">{topic}</span>
      ))}
    </div>
  )}

  <div class={`flex items-center gap-4 pt-4 border-t-2 ${dividerColor} font-mono text-[12px] uppercase tracking-[0.08em]`}>
    {repo.language && (
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 bg-current inline-block" aria-hidden="true"></span>
        {repo.language}
      </span>
    )}
    <span class="flex items-center gap-1">
      <span aria-hidden="true">★</span>
      {repo.stars}
    </span>
    <span class="ml-auto opacity-70">{formatRelativeTime(repo.pushedAt)}</span>
  </div>
</a>
