---
import Heart from './Heart.astro';
---
<nav class="border-b-[3px] border-ink bg-cream relative z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-6">
    <a href="/" class="flex items-center gap-3 group min-w-0">
      <Heart
        shadow
        class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-6"
      />
      <div class="flex flex-col leading-none min-w-0">
        <span class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.18em] text-ink/60 truncate">github.com/tightknitai</span>
        <span class="font-display font-bold text-base sm:text-lg tracking-tight">tightknit.dev</span>
      </div>
    </a>
    <div class="flex items-center gap-1 sm:gap-3 font-mono text-[12px] uppercase tracking-[0.12em] shrink-0">
      <a
        href="https://github.com/tightknitai"
        class="inline-flex items-center gap-2 px-2 sm:px-3 py-2 border-2 border-transparent hover:border-ink transition-colors"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.93c-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18.91-.25 1.89-.38 2.86-.38.97 0 1.95.13 2.86.38 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
        <span class="hidden sm:inline">github</span>
      </a>
      <a
        href="https://tightknit.ai"
        class="brutal-btn brutal-btn-alt !px-3 sm:!px-6 !py-2.5 sm:!py-3.5 !text-[11px] sm:!text-sm"
        target="_blank"
        rel="noopener"
      >
        <span class="sm:hidden">.ai</span>
        <span class="hidden sm:inline">tightknit.ai</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>
