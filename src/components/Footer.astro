---
import Heart from './Heart.astro';
const year = new Date().getFullYear();
---

<footer class="bg-cream-dim border-ink relative overflow-hidden border-t-[3px]">
  <!-- Giant brand wordmark; SVG auto-fits to viewport width -->
  <div
    class="pointer-events-none px-4 pt-12 select-none sm:px-6 lg:px-10 lg:pt-16"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 600 84"
      class="block h-auto w-full"
      preserveAspectRatio="xMidYMid meet"
      xmlns="http://www.w3.org/2000/svg"
    >
      <text
        x="0"
        y="72"
        font-family="'Space Grotesk', sans-serif"
        font-weight="700"
        font-size="84"
        textLength="600"
        lengthAdjust="spacingAndGlyphs"
        fill="none"
        stroke="#0a0a0a"
        stroke-width="1.5"
        paint-order="stroke">TIGHTKNIT.DEV</text
      >
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 pt-12 pb-10 lg:px-10">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-3">
      <div>
        <div class="text-ink/60 mb-4 font-mono text-[12px] tracking-[0.18em] uppercase">
          // open source
        </div>
        <ul class="font-display space-y-2 text-lg">
          <li>
            <a
              href="https://github.com/tightknitai"
              target="_blank"
              rel="noopener"
              class="hover:text-pink decoration-2 underline-offset-4 hover:underline"
              >github org →</a
            >
          </li>
          <li>
            <a href="#repos" class="hover:text-pink decoration-2 underline-offset-4 hover:underline"
              >all repos ↑</a
            >
          </li>
        </ul>
      </div>
      <div>
        <div class="text-ink/60 mb-4 font-mono text-[12px] tracking-[0.18em] uppercase">
          // the company
        </div>
        <ul class="font-display space-y-2 text-lg">
          <li>
            <a
              href="https://tightknit.ai"
              target="_blank"
              rel="noopener"
              class="hover:text-pink decoration-2 underline-offset-4 hover:underline"
              >tightknit.ai →</a
            >
          </li>
          <li>
            <a
              href="https://community.tightknit.ai"
              target="_blank"
              rel="noopener"
              class="hover:text-pink decoration-2 underline-offset-4 hover:underline">community →</a
            >
          </li>
        </ul>
      </div>
      <div>
        <div class="text-ink/60 mb-4 font-mono text-[12px] tracking-[0.18em] uppercase">
          // connect
        </div>
        <ul class="font-display space-y-2 text-lg">
          <li>
            <a
              href="https://www.linkedin.com/company/tightknitai"
              target="_blank"
              rel="noopener"
              class="hover:text-pink decoration-2 underline-offset-4 hover:underline">linkedin →</a
            >
          </li>
          <li>
            <a
              href="https://x.com/tightknitai"
              target="_blank"
              rel="noopener"
              class="hover:text-pink decoration-2 underline-offset-4 hover:underline"
              >x / twitter →</a
            >
          </li>
          <li>
            <a
              href="https://github.com/tightknitai"
              target="_blank"
              rel="noopener"
              class="hover:text-pink decoration-2 underline-offset-4 hover:underline">github →</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-ink/15 text-ink/60 flex flex-col gap-4 border-t-2 pt-6 font-mono text-[12px] tracking-[0.12em] uppercase sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        © {year} tightknit · made with <Heart
          class="mx-0.5 inline-block h-3.5 w-3.5 align-[-3px]"
        /> in public
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-pink inline-block h-2 w-2"></span>
        <span class="bg-yellow inline-block h-2 w-2"></span>
        <span class="bg-cyan inline-block h-2 w-2"></span>
        <span class="bg-ink inline-block h-2 w-2"></span>
      </div>
    </div>
  </div>
</footer>
